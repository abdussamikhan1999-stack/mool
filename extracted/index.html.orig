<!-- ===== FOOTER ===== -->
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <div class="fmark serif">MOOL<span class="deva">मूल</span></div>
        <p class="foot-tag">Start at the root.</p>
      </div>
      <div class="foot-col">
        <h5>Shop</h5>
