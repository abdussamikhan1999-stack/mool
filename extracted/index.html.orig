  </div>
</section>
<div class="rule"></div>

<!-- ===== SIGNUP ===== -->
<section>
  <div class="wrap">
    <div class="signup rv">
      <h2 class="serif">Start at the root</h2>
      <p>Get the one-page routine guide and early access to the launch. No miracle promises — just the ritual, done right.</p>
      <form id="signupForm">
        <input type="email" placeholder="you@email.com" required aria-label="Email address">
        <button type="submit" class="btn btn-brass">Send me the guide</button>
